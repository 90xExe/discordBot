const { Client, Intents } = require('discord.js');
const client = new Client({
    intents: [
        Intents.FLAGS.GUILDS,
        Intents.FLAGS.GUILD_MEMBERS, // Required for fetching members
        Intents.FLAGS.GUILD_MESSAGES, // Required for fetching messages from channels
        Intents.FLAGS.DIRECT_MESSAGES // Required for sending DMs
    ],
    partials: ['CHANNEL'] // Needed for DMs
});

const token = 'YOUR_BOT_TOKEN'; // Replace with your bot's token
const channelId = 'YOUR_CHANNEL_ID'; // Replace with the channel ID where the message is located
const messageId = 'YOUR_MESSAGE_ID'; // Replace with the message ID you want to send to everyone
const roleId = 'YOUR_ROLE_ID'; // Replace with the role ID that should receive the DM

// Function to add a delay
function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

client.once('ready', async () => {
    console.log(`Logged in as ${client.user.tag}!`);
    
    const guild = client.guilds.cache.first(); // Get the first server the bot is in

    // Fetch the channel and the specific message
    const channel = client.channels.cache.get(channelId);
    
    if (!channel) {
        console.log('Channel not found!');
        return;
    }

    try {
        const message = await channel.messages.fetch(messageId); // Fetch the message by its ID
        const messageContent = message.content; // Get the content of the message

        if (!messageContent) {
            console.log('Message not found or no content!');
            return;
        }

        // Fetch all the members in the server
        await guild.members.fetch(); // Ensure all members are cached

        // Send the fetched message only to members who have a specific role, with a delay between each
        const membersWithRole = guild.members.cache.filter(member => member.roles.cache.has(roleId) && !member.user.bot);

        for (const member of membersWithRole.values()) {
            try {
                await member.send(messageContent); // Send DM
                console.log(`DM sent to ${member.user.tag}`);
            } catch (error) {
                console.error(`Could not send DM to ${member.user.tag}:`, error);
            }

            // Add a delay between each DM (e.g., 2 seconds)
            await delay(2000);
        }
    } catch (error) {
        console.error('Error fetching message:', error);
    }
});

client.login(token);
